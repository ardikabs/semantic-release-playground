{
  "branches": [
    "release/v+([0-9]).+([0-9])"
  ],
  "tagFormat": "chart-v${version}",
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "preset": "conventionalcommits",
      "releaseRules": [
        {"scope": "charts", "release": "patch"},
        {"scope": "!charts", "release": false}
      ]
    }],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", {
      "prepareCmd": "./hack/sync-version.sh ${nextRelease.version} chart"
    }],
    ["@semantic-release/git", {
      "assets": ["charts/dummy/Chart.yaml"],
      "message": "chore(chart): release ${nextRelease.version} [skip ci]"
    }],
    "@semantic-release/github"
  ]
}
